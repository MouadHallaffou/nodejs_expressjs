<%- include('../partials/header') %>

<% if (typeof editData !== 'undefined') { %>
  <form action="/categories/edit/<%= editData._id %>?_method=PUT" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="name" value="<%= editData.name %>" required />
    <button type="submit" style="background-color: rgb(124, 124, 253);">Update</button>
    <a href="/categories">Cancel</a>
  </form>
<% } else { %>
  <form action="/categories" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="name" placeholder="Enter your name" required />
    <button type="submit" style="background-color: rgb(96, 151, 247);">Submit</button>
  </form>
<% } %>

<% if (typeof message !== 'undefined') { %>
  <p style="color: green;"><%= message %></p>
<% } %>

<h2>Submitted Names:</h2>
<% if (categories.length > 0) { %>
<table border="1">
  <thead>
    <tr>
      <th>#</th>
      <th>ID</th>
      <th>Name</th>
      <th>Slug</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% categories.forEach(el => { %>
    <tr>
      <td><%= categories.indexOf(el) + 1 %></td>
      <td><%= el._id %></td>
      <td><%= el.name %></td>
      <td><%= el.slug %></td>
      <td>
        <form action="/categories/delete/<%= el._id %>?_method=DELETE" method="post" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" style="background-color: rgb(244, 96, 96);">Delete</button>
        </form>
        <form action="/categories/edit/<%= el._id %>" method="get" style="display:inline;">
          <button type="submit" style="background-color: rgb(124, 124, 253);">Edit</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } else { %>
<p>No names submitted yet.</p>
<% } %>

<%- include('../partials/footer') %>
