<%- include('partials/header') %>

<% if (success && success.length) { %>
  <div style="color: green;"><%= success[0] %></div>
<% } %>
<% if (error && error.length) { %>
  <div style="color: red;"><%= error[0] %></div>
<% } %>

<h2>Interface d'administration</h2>
<p>Bienvenue, <%= admin.username %> (admin)</p>

<table border="1">
  <thead>
    <tr>
      <th>Nom</th>
      <th>Email</th>
      <th>Rôle</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(user => { %>
      <tr>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td>
          <form action="/admin/user/<%= user._id %>/role" method="post" style="display:inline;">
            <select name="role" onchange="this.form.submit()">
              <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>user</option>
              <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>admin</option>
            </select>
          </form>
        </td>
        <td>
          <% if (user._id.toString() !== admin.id.toString()) { %>
            <form action="/admin/user/<%= user._id %>/delete" method="post" style="display:inline;">
              <button type="submit" onclick="return confirm('Supprimer cet utilisateur ?')">Supprimer</button>
            </form>
          <% } else { %>
            (vous)
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('partials/footer') %>